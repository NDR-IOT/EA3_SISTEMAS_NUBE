// ============ FUNCIÓN DE INTEGRIDAD SHA-256 ============
String calcularSHA256(const String& payload) {
  byte shaResult[32];
  mbedtls_md_context_t ctx;
  mbedtls_md_init(&ctx);
  mbedtls_md_setup(&ctx, mbedtls_md_info_from_type(MBEDTLS_MD_SHA256), 0);
  mbedtls_md_starts(&ctx);
  mbedtls_md_update(&ctx, (const unsigned char*)payload.c_str(), payload.length());
  mbedtls_md_finish(&ctx, shaResult);
  mbedtls_md_free(&ctx);

  String hashStr = "";
  for (int i = 0; i < sizeof(shaResult); i++) {
    char hex[3];
    sprintf(hex, "%02x", (int)shaResult[i]);
    hashStr += hex;
  }
  return hashStr;
}

// ============ CONEXIÓN Y RECONEXIÓN WI-FI ============
void conectarWiFi() {
  if (WiFi.status() == WL_CONNECTED) return;

  Serial.print("Conectando a red Wi-Fi: ");
  Serial.println(ssid);
  WiFi.mode(WIFI_STA);
  WiFi.begin(ssid, password);

  int intentos = 0;
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
    intentos++;
    if (intentos >= 30) {
      Serial.println("\nReintentando enlace Wi-Fi...");
      WiFi.disconnect();
      WiFi.begin(ssid, password);
      intentos = 0;
    }
  }
  Serial.print("\nWi-Fi conectado. IP asignada: ");
  Serial.println(WiFi.localIP());
}

// ============ RECONEXIÓN AUTOMÁTICA MQTT CON mTLS ============
void reconectarMQTT() {
  while (!client.connected()) {
    if (WiFi.status() != WL_CONNECTED) {
      conectarWiFi();
    }

    Serial.print("Iniciando handshake mTLS con el broker...");
    if (client.connect("ESP32_Client")) {
      Serial.println(" [CONEXIÓN AUTORIZADA]");
    } else {
      Serial.print(" [FALLO], rc=");
      Serial.print(client.state());
      Serial.println(" -> Reintentando en 5 segundos...");
      delay(5000);
    }
  }
}

void setup() {
  Serial.begin(115200);
  conectarWiFi();

  // Sincronización NTP para validar vigencia temporal de los certificados X.509
  configTime(0, 0, "pool.ntp.org", "time.nist.gov");
  Serial.println("Sincronizando reloj NTP...");
  delay(2000);

  // Carga de autoridad certificadora y credenciales mutuas del cliente
  wifiClient.setCACert(ca_cert);
  wifiClient.setCertificate(client_cert);
  wifiClient.setPrivateKey(client_key);

  client.setServer(mqtt_server, mqtt_port);
}

void loop() {
  // Bucle infinito con tolerancia a fallos de red y sesión MQTT
  if (WiFi.status() != WL_CONNECTED) {
    conectarWiFi();
  }
  if (!client.connected()) {
    reconectarMQTT();
  }
  client.loop();

  static unsigned long ultimoEnvio = 0;
  if (millis() - ultimoEnvio >= 10000) {
    ultimoEnvio = millis();

    float temperatura = 25.50;
    String valorStr = String(temperatura, 2);
    String hashSHA256 = calcularSHA256(valorStr);

    String mensajeJSON = "{\"val\": " + valorStr + ", \"hash\": \"" + hashSHA256 + "\"}";

    if (client.publish(mqtt_topic, mensajeJSON.c_str())) {
      Serial.println("Telemetría publicada: " + mensajeJSON);
    } else {
      Serial.println("Error al publicar telemetría.");
    }
  }
}
